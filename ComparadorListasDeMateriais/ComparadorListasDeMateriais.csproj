<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- refat2026: migrado de net48 para net8.0-windows para usar a HefestoCAM (.NET 8) em runtime. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ComparadorListasDeMateriais</RootNamespace>
    <AssemblyName>ComparadorListasDeMateriais</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Mantém o Properties/AssemblyInfo.cs existente (evita atributos duplicados). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Template .xlsx embutido (usado por FuncoesUteis.GetResourceFileStream("Template")). -->
  <ItemGroup>
    <None Remove="Resources\Template.xlsx" />
    <EmbeddedResource Include="Resources\Template.xlsx" />
  </ItemGroup>

  <!-- Pacotes. System.Configuration.ConfigurationManager habilita Properties/Settings (ApplicationSettingsBase) no .NET 8. -->
  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <!-- Bibliotecas Hefesto/ModelagemTorre (.NET 8) e MathNet, na pasta de deploy. -->
  <ItemGroup>
    <Reference Include="HefestoCAM">
      <HintPath>..\..\..\..\..\Engetower\ModelagemTorre3D\HefestoCAM.dll</HintPath>
    </Reference>
    <Reference Include="ModelagemTorre.ObjetosCore">
      <HintPath>..\..\..\..\..\Engetower\ModelagemTorre3D\ModelagemTorre.ObjetosCore.dll</HintPath>
    </Reference>
    <Reference Include="ModelagemTorre">
      <HintPath>..\..\..\..\..\Engetower\ModelagemTorre3D\ModelagemTorre.dll</HintPath>
    </Reference>
    <Reference Include="MathNet.Numerics">
      <HintPath>..\..\..\..\..\Engetower\ModelagemTorre3D\MathNet.Numerics.dll</HintPath>
    </Reference>
    <Reference Include="MathNet.Spatial">
      <HintPath>..\..\..\..\..\Engetower\ModelagemTorre3D\MathNet.Spatial.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Interop do Office (Excel) via COM. Requer Excel + PIAs registrados na máquina. -->
  <ItemGroup>
    <COMReference Include="Microsoft.Office.Core">
      <Guid>{2DF8D04C-5BFA-101B-BDE5-00AA0044DE52}</Guid>
      <VersionMajor>2</VersionMajor>
      <VersionMinor>8</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>primary</WrapperTool>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
    <COMReference Include="Microsoft.Office.Interop.Excel">
      <Guid>{00020813-0000-0000-C000-000000000046}</Guid>
      <VersionMajor>1</VersionMajor>
      <VersionMinor>9</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>primary</WrapperTool>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
    <COMReference Include="VBIDE">
      <Guid>{0002E157-0000-0000-C000-000000000046}</Guid>
      <VersionMajor>5</VersionMajor>
      <VersionMinor>3</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>primary</WrapperTool>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

</Project>
